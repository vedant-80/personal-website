# Local PostgreSQL from docker-compose.yml. Production uses your hosted database URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal_website?sslmode=disable"
# Generate a random secret for your environment; do not reuse this placeholder.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
ADMIN_EMAIL="your-google-email@example.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
EMAIL_SEND_MODE="sink"
